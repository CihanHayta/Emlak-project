# Bu dosyayı kopyalayıp ".env" adıyla kaydedin (Vite sadece .env dosyasını,
# ve sadece VITE_ ile başlayan değişkenleri tarayıcıya taşır).

# server/ altındaki backend'in çalıştığı adres.
VITE_API_URL=http://localhost:4000/api/v1
# Public site'ın form gönderimlerinin hangi ofise (tenant) ait olduğunu
# söyler — server/scripts/bootstrap-owner.js'in çıktısındaki tenant id.
VITE_TENANT_ID=

# Firebase Console > Project settings > General > "Your apps" > Web app
# altındaki firebaseConfig değerleri. Bunlar gizli değil (tarayıcıya zaten
# gönderilirler) — gerçek erişim kontrolü Firestore/Storage güvenlik
# kurallarında ve backend'in Admin SDK'sında yapılır.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
