# Bu dosyayı kopyalayıp ".env" adıyla kaydedin (Vite sadece .env dosyasını,
# ve sadece VITE_ ile başlayan değişkenleri tarayıcıya taşır).

# server/ altındaki backend'in çalıştığı adres.
#
# YEREL GELİŞTİRME: backend'in doğrudan adresi (http://localhost:4000/api/v1).
#
# PRODUCTION (Vercel): BİLEREK backend'in gerçek (Railway) adresi DEĞİL,
# "/api/v1" — kök dizindeki vercel.json bunu Railway backend'ine proxy'ler.
# Neden: frontend (Vercel) ve backend (Railway) farklı domain'lerde,
# tarayıcı için bu "cross-site" bir istek sayılır. Cookie'ler
# (SameSite=None; Secure) doğru ayarlansa bile Safari (ve iOS'taki HER
# tarayıcı — Chrome dahil, hepsi WebKit kullanıyor) varsayılan olarak
# üçüncü taraf (cross-site) cookie'leri TAMAMEN engeller — bu yüzden giriş
# Chrome'da çalışıp Safari/mobilde "Oturum oluşturuldu ama kullanıcı
# bilgisi alınamadı" hatasıyla başarısız oluyordu (2026-08-09'da bulunup
# düzeltildi). "/api/v1" ile istekler tarayıcı için AYNI origin'e gidiyor,
# vercel.json'daki rewrite bunu görünmez şekilde Railway'e yönlendiriyor —
# cookie artık cross-site değil, Safari'nin engellemesi hiç devreye girmiyor.
VITE_API_URL=http://localhost:4000/api/v1
# Public site'ın form gönderimlerinin hangi ofise (tenant) ait olduğunu
# söyler — server/scripts/bootstrap-owner.js'in çıktısındaki tenant id.
VITE_TENANT_ID=

# Firebase Console > Project settings > General > "Your apps" > Web app
# altındaki firebaseConfig değerleri. Bunlar gizli değil (tarayıcıya zaten
# gönderilirler) — gerçek erişim kontrolü Firestore/Storage güvenlik
# kurallarında ve backend'in Admin SDK'sında yapılır.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# WhatsApp Embedded Signup (bkz. admin/lib/whatsappEmbeddedSignup.js) —
# Meta App Dashboard'daki App ID ve Business Settings'te oluşturulacak bir
# "WhatsApp Embedded Signup" konfigürasyonunun id'si. Gizli değiller
# (popup zaten tarayıcıda açılıyor), ama ikisi de dolmadan "WhatsApp
# Hattını Bağla" butonu devre dışı kalır.
VITE_WHATSAPP_APP_ID=
VITE_WHATSAPP_CONFIG_ID=
