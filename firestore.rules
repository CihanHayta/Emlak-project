rules_version = '2';

// Bu proje her yerde Firebase Admin SDK üzerinden çalışıyor (bkz.
// server/src/firebase/admin.js) — tarayıcı hiçbir zaman Firestore'a
// doğrudan bağlanmıyor, her şey kimlik doğrulanmış Express API'den geçiyor
// (tenant izolasyonu orada, server/src/repositories/base.repository.js'te
// yapısal olarak zorlanıyor).
//
// Admin SDK bu kuralları zaten BYPASS eder — yani bu dosyanın uygulamanın
// normal çalışmasına hiçbir etkisi yok. Tek amacı ikinci bir savunma
// hattı: İleride biri (yanlışlıkla ya da bilerek) tarayıcıdan doğrudan
// Firestore Client SDK ile bir bağlantı kurarsa, o bağlantı burada
// reddedilsin.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
