# Bu dosyayı kopyalayıp ".env" adıyla kaydedin ve kendi değerlerinizi girin.
# ".env" asla git'e gönderilmez (.gitignore'da).

# --- Her zaman zorunlu ---
NODE_ENV=development
PORT=4000
# mock: WhatsApp/Instagram'a hiç bağlanmadan sahte gönderim yapar (outbox'a yazar).
# live: gerçek Meta Graph API'ye bağlanır (aşağıdaki WHATSAPP_*/INSTAGRAM_* zorunlu olur).
INTEGRATIONS_MODE=mock
# İzin verilen origin'ler, virgülle ayrılmış. "*" yasak (güvenlik).
CORS_ORIGINS=http://localhost:5173,http://localhost:5183

# --- PostgreSQL + Cloudflare R2 — Firestore/Firebase Storage/Firebase Auth'un
# yerine geçti, uygulamanın TEK veri/dosya/kimlik doğrulama altyapısı bu. Bu
# uygulama TEK-KİRACILI: her müşteriye ayrı, bağımsız bir deployment (kendi
# sunucusu + kendi bu veritabanı + kendi R2 bucket'ı) olarak satılıyor, bu
# yüzden "hangi tenant hangi DB'de" diye yönlendiren bir kayıt defteri YOK —
# tek, sabit bir DATABASE_URL yeterli. Kullanıcı şifreleri `bcryptjs` ile
# hash'lenip `users.password_hash`'te, oturumlar `sessions` tablosunda
# tutulur (bkz. src/services/auth.service.js) — ayrı bir kimlik doğrulama
# servisine bağımlılık YOK, ilk owner hesabı `scripts/bootstrap-owner.js`
# ile oluşturulur (bkz. docs/INSTALL.md).
DATABASE_URL=postgres://user:pass@localhost:5432/emlak_db
# mock: R2'ye hiç bağlanmadan, sunucunun kendi diskine (.mock-r2/) yazar —
# uçtan uca upload akışını gerçek bir bulut hesabı olmadan test etmeyi sağlar.
# live: gerçek Cloudflare R2'ye bağlanır (aşağıdaki R2_* değerleri zorunlu olur).
STORAGE_MODE=mock

# --- Sadece STORAGE_MODE=live iken zorunlu ---
# Account ID + endpoint: Cloudflare Dashboard > R2 > bucket > Settings >
# "S3 API" (bucket adı olmadan, sadece https://<accountId>.r2.cloudflarestorage.com kısmı).
R2_ACCOUNT_ID=
# Access Key ID + Secret Access Key: R2 > "Manage R2 API Tokens" > Create API Token.
# Secret Access Key SADECE oluşturulduğu anda gösterilir, kimseyle (Claude dahil) PAYLAŞMAYIN.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
# Public Development URL (r2.dev) ya da bağlı bir custom domain — bucket
# Settings > Public access altında. Boş bırakılırsa upload sonrası dönen
# `url` null olur, çağıran taraf getSignedUrl kullanmalı.
R2_PUBLIC_URL=

# --- Sadece INTEGRATIONS_MODE=live iken zorunlu ---
# TEK bir Meta App — her tenant kendi Instagram hesabını bu App üzerinden
# OAuth ile bağlar (bkz. services/instagramOAuth.service.js). Artık tek bir
# global INSTAGRAM_ACCESS_TOKEN YOK; her tenant'ın token'ı OAuth akışıyla
# alınıp tenants/{id}.instagram altında şifreli saklanır.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
# Aynı mantık WhatsApp için — her tenant kendi hattını Embedded Signup ile
# bağlar (bkz. services/whatsappOAuth.service.js), tek bir global
# WHATSAPP_PHONE_NUMBER_ID/ACCESS_TOKEN YOK.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# AES-256-GCM anahtarı, 64 hex karakter — `openssl rand -hex 32` ile üretin.
# Tenant'ların Instagram/WhatsApp token'larını Postgres'te şifrelemek için kullanılır.
TOKEN_ENCRYPTION_KEY=
# Meta'nın OAuth callback'i çağırırken kullanacağı, dışarıdan erişilebilir
# backend adresi (Meta App Dashboard > Instagram > OAuth Redirect URIs'e de
# aynı `${PUBLIC_BACKEND_URL}/api/v1/instagram/oauth/callback` eklenmeli).
PUBLIC_BACKEND_URL=http://localhost:4000
# OAuth tamamlanınca kullanıcının geri yönlendirileceği admin panel adresi.
FRONTEND_URL=http://localhost:5173

# --- Opsiyonel (verilmezse makul bir varsayılan kullanılır) ---
LOG_LEVEL=info
SESSION_COOKIE_NAME=session
# "Beni Hatırla" işaretliyse (varsayılan 14 gün), işaretlenmezse (varsayılan
# 1 gün) kullanılan oturum süresi — tamamen bizim seçtiğimiz bir değer.
SESSION_COOKIE_REMEMBER_DAYS=14
SESSION_COOKIE_DEFAULT_DAYS=1
SIGNED_URL_EXPIRY_SECONDS=900
META_GRAPH_API_VERSION=v21.0
# Verilirse, sunucuda beklenmeyen (5xx) bir hata oluştuğunda Telegram'a
# bildirim gider (bkz. utils/notifyTelegram.js). @BotFather'dan "/newbot"
# ile token alın, bota bir mesaj atıp getUpdates ile chat id'nizi öğrenin.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
