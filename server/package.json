    "helmet": "^8.0.0",
    "http-errors": "^2.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "uuid": "^11.0.5",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
