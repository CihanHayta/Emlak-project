{
  "root": true,
  "env": { "node": true, "es2022": true, "jest": true },
  "extends": ["eslint:recommended", "prettier"],
  "parserOptions": { "ecmaVersion": 2022, "sourceType": "module" },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }]
  },
  "overrides": [
    {
      "files": ["src/controllers/**/*.js"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": ["**/repositories/*", "**/firebase/*"] }]
      }
    },
    {
      "files": ["src/services/**/*.js"],
      "rules": {
        "no-restricted-imports": ["error", { "paths": ["express"], "patterns": ["**/controllers/*", "**/routes/*"] }]
      }
    },
    {
      "files": ["src/repositories/**/*.js"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": ["**/services/*"] }]
      }
    }
  ]
}
